<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <!-- Vite compiles ClientApp into wwwroot; MSBuild must not walk the source
         tree (node_modules alone is tens of thousands of files). -->
    <Content Remove="ClientApp\**" />
    <None Remove="ClientApp\**" />
    <Compile Remove="ClientApp\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StayHost.Infrastructure\StayHost.Infrastructure.csproj" />
    <ProjectReference Include="..\StayHost.Domain\StayHost.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="9.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Somewhere to keep a developer's own gateway keys that is not this repo.
         docs/07 §14.4: a VNPay HashSecret signs money, and one belonging to a
         person rather than published by a vendor has no business in git history.
         Loaded automatically in Development, ignored everywhere else — production
         reads the same settings from environment variables (docker-compose.prod).
         Set one with: dotnet user-secrets set Psp:Vnpay:HashSecret <value>
         (an XML comment may not contain a double hyphen, so the flags are not
         spelled out here; run the command from src/StayHost.Web). -->
    <UserSecretsId>stayhost-web-psp</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- GatewayReply decides whether a gateway's answer is about the money at
         all, which is worth locking down in tests without making it public. -->
    <InternalsVisibleTo Include="StayHost.Web.Tests" />
  </ItemGroup>

</Project>
